{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Register missing fields",
      "method": "POST",
      "path": "/",
      "body": {"action": "register"},
      "expectedStatus": 400,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Login missing fields",
      "method": "POST",
      "path": "/",
      "body": {"action": "login"},
      "expectedStatus": 400,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Me without session",
      "method": "POST",
      "path": "/",
      "body": {"action": "me"},
      "expectedStatus": 401,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Chat without messages",
      "method": "POST",
      "path": "/",
      "body": {},
      "expectedStatus": 400,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "GET not allowed",
      "method": "GET",
      "path": "/",
      "expectedStatus": 405
    },
    {
      "name": "Support ticket without message",
      "method": "POST",
      "path": "/",
      "body": {"action": "support_ticket"},
      "expectedStatus": 400,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Support ticket with message",
      "method": "POST",
      "path": "/",
      "body": {"action": "support_ticket", "message": "Test support message", "phone": "79001234567", "name": "Test User"},
      "expectedStatus": 200,
      "expectedBody": {"ok": true},
      "bodyMatcher": "partial"
    },
    {
      "name": "Create order missing fields",
      "method": "POST",
      "path": "/",
      "body": {"action": "create_order"},
      "expectedStatus": 400,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Admin auth wrong password",
      "method": "POST",
      "path": "/",
      "body": {"action": "admin_auth", "admin_password": "wrong"},
      "expectedStatus": 403,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "List tickets without password",
      "method": "POST",
      "path": "/",
      "body": {"action": "list_tickets"},
      "expectedStatus": 403,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "List orders without password",
      "method": "POST",
      "path": "/",
      "body": {"action": "list_orders"},
      "expectedStatus": 403,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Update ticket without password",
      "method": "POST",
      "path": "/",
      "body": {"action": "update_ticket", "ticket_id": 1, "status": "resolved"},
      "expectedStatus": 403,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Update profile without session",
      "method": "POST",
      "path": "/",
      "body": {"action": "update_profile", "name": "Test"},
      "expectedStatus": 401,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Delete account without session",
      "method": "POST",
      "path": "/",
      "body": {"action": "delete_account"},
      "expectedStatus": 401,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "User stats without session",
      "method": "POST",
      "path": "/",
      "body": {"action": "user_stats"},
      "expectedStatus": 401,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "User orders without session",
      "method": "POST",
      "path": "/",
      "body": {"action": "user_orders"},
      "expectedStatus": 401,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    }
  ]
}